# cestaWEB — variáveis de ambiente
#
# São DOIS deploys deste mesmo código no Railway: um apontando para a API do OCTO
# InfoPrice, outro para a do Interno. O código é igual; o que separa é este
# arquivo. Nunca commite o .env de verdade.
#
# Copie para .env (local) ou cadastre no painel do Railway (produção).

# ── OCTO ────────────────────────────────────────────────────────────────────────
# URL EXTERNA da API do OCTO. A API roda na VM, mas é publicada — é por aqui que
# este app fala com ela. Sem barra no final.
OCTO_API_URL=https://api.octo.exemplo.com.br

# Token de serviço. Prova que a chamada vem deste app.
# ⚠️ O MESMO valor tem de estar em CESTA_SERVICE_TOKEN no .env do OCTO.
# Gere com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
OCTO_SERVICE_TOKEN=troque-me

# Timeout das chamadas ao OCTO, em segundos.
OCTO_TIMEOUT=30

# ── Sessão ──────────────────────────────────────────────────────────────────────
# Assina o cookie onde o grant fica guardado. Sem isso o app sobe mas recusa
# acesso — melhor negar do que assinar com segredo previsível.
# Gere com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=troque-me
SESSION_COOKIE=cestaweb_sessao

# ── Upload ──────────────────────────────────────────────────────────────────────
# Teto do arquivo, em bytes. 5 MB cobre planilha de milhares de linhas; acima
# disso costuma ser formatação e imagem, não dado.
MAX_UPLOAD_BYTES=5242880

# ── Aparência / navegação ───────────────────────────────────────────────────────
# Rótulo do ambiente, no rodapé. Com os dois deploys no ar, é o que tira a dúvida
# de qual OCTO esta página atende.
STACK_LABEL=InfoPrice

# Front do OCTO, para o botão "voltar ao OCTO".
OCTO_FRONT_URL=https://octo.exemplo.com.br

# ── Diversos ────────────────────────────────────────────────────────────────────
# 'local' desliga o https_only do cookie (para rodar em http://localhost).
ENV=prod
LOG_LEVEL=INFO
